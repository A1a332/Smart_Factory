#: Mods/Remote_Factory/Source/Remote_Factory/Remote_FactoryUpgradeRegistry.cpp(1040)
msgid ",ShopPowerShard_Desc"
msgstr "Buy an Enhanced Power Shard with FICSIT coupons. One purchase = one shard; purchase as many as you need."

#. Key:	Desc_UpgradePowerStorage
#. SourceLocation:	Mods/Remote_Factory/Source/Remote_Factory/Remote_FactoryUpgradeRegistry.cpp(166)
#: Mods/Remote_Factory/Source/Remote_Factory/Remote_FactoryUpgradeRegistry.cpp(166)
msgid ",Desc_UpgradePowerStorage"
msgstr "A very large battery bank (1000 MWh). Stores the grid's surplus and releases it during a shortfall -- the factory-wide total shows up in the readout at the top of the Remote Factory."

#. Key:	Desc_UpgradeStorage
#. SourceLocation:	Mods/Remote_Factory/Source/Remote_Factory/Remote_FactoryUpgradeRegistry.cpp(178)
#: Mods/Remote_Factory/Source/Remote_Factory/Remote_FactoryUpgradeRegistry.cpp(178)
msgid ",Desc_UpgradeStorage"
msgstr "An 8 x 12 = 96 slot container for stockpiling a whole production line's intermediates. The Remote Factory picks it up in its scan, so you can check the contents from there."

#. Key:	Milestone_UpgradeStorage
#. SourceLocation:	Mods/Remote_Factory/Source/Remote_Factory/Remote_FactoryUpgradeRegistry.cpp(1786)
#: Mods/Remote_Factory/Source/Remote_Factory/Remote_FactoryUpgradeRegistry.cpp(1786)
msgid ",Milestone_UpgradeStorage"
msgstr "远程工厂 · Super Battery"

#. Key:	MilestoneDesc_UpgradeStorage
#. SourceLocation:	Mods/Remote_Factory/Source/Remote_Factory/Remote_FactoryUpgradeRegistry.cpp(1787)
#: Mods/Remote_Factory/Source/Remote_Factory/Remote_FactoryUpgradeRegistry.cpp(1787)
msgid ",MilestoneDesc_UpgradeStorage"
msgstr "Unlocks the Super Battery (1000 MWh, 100 MW charge rate). It links up with the terminal and shows up in the terminal's machine list once built."

#. Key:	Milestone_UpgradeAccelerator
#. SourceLocation:	Mods/Remote_Factory/Source/Remote_Factory/Remote_FactoryUpgradeRegistry.cpp(1809)
#: Mods/Remote_Factory/Source/Remote_Factory/Remote_FactoryUpgradeRegistry.cpp(1809)
msgid ",Milestone_UpgradeAccelerator"
msgstr "远程工厂 · Production Accelerator"

#. Key:	MilestoneDesc_UpgradeAccelerator
#. SourceLocation:	Mods/Remote_Factory/Source/Remote_Factory/Remote_FactoryUpgradeRegistry.cpp(1810)
#: Mods/Remote_Factory/Source/Remote_Factory/Remote_FactoryUpgradeRegistry.cpp(1810)
msgid ",MilestoneDesc_UpgradeAccelerator"
msgstr "Unlocks the Production Accelerator (up to 2.5x output, no power shards needed). It links up with the terminal and shows up in the terminal's machine list once built."

#. Key:	Desc_UpgradeCloudDownloader
#. SourceLocation:	Mods/Remote_Factory/Source/Remote_Factory/Remote_FactoryUpgradeRegistry.cpp(189)
#: Mods/Remote_Factory/Source/Remote_Factory/Remote_FactoryUpgradeRegistry.cpp(189)
msgid ",Desc_UpgradeCloudDownloader"
msgstr "The other half of the cloud storage system: pulls items back OUT of the central pool into its own buffer, one stack at a time. Open it like any storage container and grab what you need."

#. Key:	Desc_UpgradeCloudFluidUploader
#. SourceLocation:	Mods/Remote_Factory/Source/Remote_Factory/Remote_FactoryUpgradeRegistry.cpp(201)
#: Mods/Remote_Factory/Source/Remote_Factory/Remote_FactoryUpgradeRegistry.cpp(201)
msgid ",Desc_UpgradeCloudFluidUploader"
msgstr "Attach a pipe and every cubic meter that arrives is uploaded into the cloud pool as its own fluid entry -- liquids and gases are accounted separately from solid items."

#. Key:	Desc_UpgradeCloudFluidDownloader
#. SourceLocation:	Mods/Remote_Factory/Source/Remote_Factory/Remote_FactoryUpgradeRegistry.cpp(212)
#: Mods/Remote_Factory/Source/Remote_Factory/Remote_FactoryUpgradeRegistry.cpp(212)
msgid ",Desc_UpgradeCloudFluidDownloader"
msgstr "Press E to pick which fluid the cloud should send back out, then attach a pipe: the station feeds the selected fluid into the network as long as the cloud holds stock."

#. Key:	Shard_Name
#. SourceLocation:	Mods/Remote_Factory/Source/Remote_Factory/Remote_FactoryUpgradeRegistry.cpp(263)
#: Mods/Remote_Factory/Source/Remote_Factory/Remote_FactoryUpgradeRegistry.cpp(263)
msgid ",Shard_Name"
msgstr "Enhanced Power Shard"

#. Key:	Shard_Desc
#. SourceLocation:	Mods/Remote_Factory/Source/Remote_Factory/Remote_FactoryUpgradeRegistry.cpp(314)
#: Mods/Remote_Factory/Source/Remote_Factory/Remote_FactoryUpgradeRegistry.cpp(314)
msgid ",Shard_Desc"
msgstr "A refined shard for the vanilla shard slots. It overclocks exactly like a vanilla shard, but packs more potential per slot -- and the machines' potential ceiling rises with your MAM research (up to 400%: 3 shards = 1 + 3 x 1.0). Power draw follows the vanilla curve, so high overclocks burn coal fast."

#. Key:	Desc_UpgradeAccelerator
#. SourceLocation:	Mods/Remote_Factory/Source/Remote_Factory/Remote_FactoryUpgradeRegistry.cpp(326)
#: Mods/Remote_Factory/Source/Remote_Factory/Remote_FactoryUpgradeRegistry.cpp(326)
msgid ",Desc_UpgradeAccelerator"
msgstr "Needs no power shards: once powered it applies a long-lasting production multiplier to itself. Capped at 2.5x -- beyond that the power draw outgrows the output and you are better off building another machine."

