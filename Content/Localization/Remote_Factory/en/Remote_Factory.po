#. Key:	Desc_Remote_Factory
#. SourceLocation:	Mods/Remote_Factory/Source/Remote_Factory/Remote_FactoryRegistry.cpp(147)
#: Mods/Remote_Factory/Source/Remote_Factory/Remote_FactoryRegistry.cpp(147)
msgid ",Desc_Remote_Factory"
msgstr "A factory-wide console. Build it and press E: from your HUB you can see the output of every machine plus total factory generation and draw, open any machine's own panel remotely, and pull its output straight out."

#. Key:	Milestone_Remote_Factory
#. SourceLocation:	Mods/Remote_Factory/Source/Remote_Factory/Remote_FactoryRegistry.cpp(227)
#: Mods/Remote_Factory/Source/Remote_Factory/Remote_FactoryRegistry.cpp(227)
msgid ",Milestone_Remote_Factory"
msgstr "Unlocks the handheld Remote Factory and the High-Capacity Storage Unit. Equip the terminal from your inventory to browse every machine, operate them remotely, pull their output and teleport -- from anywhere in the world."

#. Key:	Tree_Remote_Factory
